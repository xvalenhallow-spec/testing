local function _decode(_input)
    local _out = {}
    local _buffer, _bits = 0, 0
    local _key = 91
    for _i = 1, #_input do
        local _char = _input:sub(_i, _i)
        if _char ~= "=" then
            local _value = _alphabet:find(_char, 1, true) - 1
