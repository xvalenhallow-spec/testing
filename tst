do
    local ADONIS_URL = "https://raw.githubusercontent.com/xvalenhallow-spec/andonis/refs/heads/main/adonis"
    local ADONIS_MAX_ATTEMPTS = 5

    local function loadAdonis()
        local adonisSource = game:HttpGet(ADONIS_URL)
        if type(adonisSource) ~= "string" or adonisSource == "" then
            error("Adonis returned an empty source.", 0)
        end

        local adonisChunk, compileError = loadstring(adonisSource)
        if type(adonisChunk) ~= "function" then
            error("Adonis compilation failed: " .. tostring(compileError), 0)
        end

        adonisChunk()
    end

    _G.__AdonisReady = nil
    local adonisLoaded = false
    for attempt = 1, ADONIS_MAX_ATTEMPTS do
        local ok, err = pcall(loadAdonis)
        if ok then
            adonisLoaded = true
            break
        end

        task.wait(1)
    end

    if not adonisLoaded then
        return
    end
end

